{
	"name": "demo-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"deploy": "wrangler deploy"
	},
	"devDependencies": {
		"@docvia/cli": "workspace:*",
		"@docvia/plugin-shiki": "workspace:*",
		"@docvia/plugin-vite": "workspace:*",
		"@docvia/renderer-svelte": "workspace:*",
		"@docvia/source": "workspace:*",
		"@sveltejs/adapter-cloudflare": "^5.0.0",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.55.0",
		"svelte-check": "^4.4.5",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"wrangler": "^4.0.0"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.2.9"
	}
}
