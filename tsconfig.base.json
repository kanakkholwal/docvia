{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"declaration": false /* Generate .d.ts files from TypeScript and JavaScript files in your project. */,
		"declarationMap": false,
		"sourceMap": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": true,
		"paths": {
			"@docvia/cli": ["./packages/cli/src"],
			"@docvia/compiler": ["./packages/compiler/src"],
			"@docvia/core": ["./packages/core/src"],
			"@docvia/ir": ["./packages/ir/src"],
			"@docvia/plugins": ["./packages/plugins/src"],
			"@docvia/renderer-core": ["./packages/renderer-core/src"],
			"@docvia/renderer-react": ["./packages/renderer-react/src"],
			"@docvia/renderer-svelte": ["./packages/renderer-svelte/src"],
			"@docvia/runtime": ["./packages/runtime/src"],
			"@docvia/schema": ["./packages/schema/src"],
			"@docvia/search": ["./packages/search/src"],
			"@docvia/source": ["./packages/source/src"],
			"@docvia/plugin-vite": ["./packages/plugin-vite/src"],
			"@docvia/plugin-next": ["./packages/plugin-next/src"],
			"@docvia/plugin-shiki": ["./packages/plugin-shiki/src"],
			"@docvia/plugin-openapi": ["./packages/plugin-openapi/src"]
		}
	}
}
