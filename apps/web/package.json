{
	"name": "@docvia/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "cross-env PORTLESS_HTTPS=0 portless",
		"dev:app": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "wrangler deploy",
		"cf:typegen": "wrangler types",
		"baby-ui:css": "node scripts/baby-ui-css.mjs"
	},
	"devDependencies": {
		"@docvia/build": "workspace:*",
		"@docvia/cli": "workspace:*",
		"@docvia/markdown": "workspace:*",
		"@docvia/plugin-mermaid": "workspace:*",
		"@docvia/plugin-openapi": "workspace:*",
		"@docvia/plugin-shiki": "workspace:*",
		"@lucide/svelte": "^1.52.0",
		"@sveltejs/adapter-cloudflare": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-array": "^3.2.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"clsx": "^2.1.1",
		"shiki": "^4.5.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wrangler": "catalog:"
	},
	"dependencies": {
		"@docvia/build": "workspace:*",
		"@docvia/core": "workspace:*",
		"@docvia/search": "workspace:*",
		"@fontsource-variable/geist-pixel": "^5.3.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"bits-ui": "^2.19.5",
		"d3-array": "^3.2.4",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"mermaid": "^12.1.0",
		"simple-icons": "^16.34.0"
	},
	"portless": {
		"name": "docvia",
		"script": "dev:app"
	}
}
