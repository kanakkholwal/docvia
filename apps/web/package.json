{
	"name": "@docvia/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "docvia sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "docvia sync && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "wrangler deploy",
		"cf:typegen": "wrangler types"
	},
	"devDependencies": {
		"@docvia/cli": "workspace:*",
		"@docvia/plugin-mermaid": "workspace:*",
		"@docvia/plugin-shiki": "workspace:*",
		"@docvia/plugin-vite": "workspace:*",
		"@lucide/svelte": "^1.52.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "^4.3.3",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"shiki": "^4.5.0",
		"svelte": "catalog:",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"@docvia/compiler": "workspace:*",
		"@docvia/renderer-core": "workspace:*",
		"@docvia/renderer-svelte": "workspace:*",
		"@docvia/search": "workspace:*",
		"@docvia/source": "workspace:*",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"mermaid": "^12.1.0",
		"simple-icons": "^16.34.0"
	}
}
