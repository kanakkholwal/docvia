{
	"name": "@docvia/plugin-vite",
	"version": "1.0.0",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"@docvia/plugins": "workspace:*",
		"@docvia/runtime": "workspace:*"
	},
	"peerDependencies": {
		"@docvia/source": "workspace:*",
		"vite": "^8.0.0"
	},
	"devDependencies": {
		"@docvia/source": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"description": "Vite plugin for docvia: in-process compile, virtual source and registry modules, HMR",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/plugin-vite"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	],
	"sideEffects": false
}
