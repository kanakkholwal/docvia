{
	"name": "@docvia/plugin-vite",
	"version": "0.2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/core": "workspace:*",
		"@docvia/ir": "workspace:*",
		"@docvia/runtime": "workspace:*",
		"@docvia/schema": "workspace:*",
		"@docvia/source": "workspace:*"
	},
	"devDependencies": {
		"@docvia/plugins": "workspace:*",
		"@types/node": "^20.0.0",
		"svelte": "^5.49.2",
		"typescript": "^5.5.0",
		"vite": "^6.0.0"
	},
	"description": "Vite plugin for docvia (?docvia virtual modules)",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/plugin-vite"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	]
