{
	"name": "@docvia/core",
	"version": "0.2.0",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"hast-util-sanitize": "^5.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-directive": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "catalog:",
		"svelte": "catalog:",
		"typescript": "catalog:"
	},
	"description": "Markdown parsing pipeline (micromark + unified) for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	],
	"sideEffects": false,
	"inlinedDependencies": {
		"@types/hast": "3.0.5",
		"@types/unist": "3.0.3"
	}
}
