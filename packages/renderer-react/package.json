{
	"name": "@docvia/renderer-react",
	"version": "0.1.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./client": {
			"types": "./dist/client.d.mts",
			"import": "./dist/client.mjs",
			"default": "./dist/client.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"test": "echo \"no tests yet\""
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"@docvia/renderer-core": "workspace:*",
		"shiki": "^4.0.2"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"typescript": "^5.9.3"
	},
	"description": "React renderer adapter for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/renderer-react"
	},
	"publishConfig": {
