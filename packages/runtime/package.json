{
	"name": "@docvia/runtime",
	"version": "2.0.0",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/core": "workspace:*",
		"@docvia/ir": "workspace:*",
		"@docvia/plugins": "workspace:*",
		"@docvia/schema": "workspace:*",
		"@node-rs/xxhash": "^1.7.8",
		"tinyglobby": "^0.2.17",
		"oxc-parser": "^0.152.0",
		"magic-string": "^1.4.3"
	},
	"devDependencies": {
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"@docvia/source": "workspace:*",
		"@docvia/renderer-core": "workspace:*"
	},
	"description": "Stateful incremental compile service shared by docvia build, dev, and SSR modes",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/runtime"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	],
	"sideEffects": false
}
