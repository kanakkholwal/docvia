{
	"name": "@docvia/plugin-next",
	"version": "0.4.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./loader": {
			"types": "./dist/loader.d.mts",
			"import": "./dist/loader.mjs",
			"default": "./dist/loader.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"@docvia/plugins": "workspace:*",
		"@docvia/runtime": "workspace:*",
		"chokidar": "^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"next": "^16",
		"typescript": "^5.9.3",
		"webpack": "^5"
	},
	"peerDependencies": {
		"next": ">=14"
	},
	"description": "Next.js integration for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/plugin-next"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	]
}
