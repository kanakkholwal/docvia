{
	"name": "@docvia/plugin-next",
	"version": "2.0.0",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./loader": "./dist/loader.js",
		"./macro-loader": "./dist/macro-loader.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"@docvia/plugins": "workspace:*",
		"@docvia/runtime": "workspace:*",
		"chokidar": "^5.0.0",
		"jiti": "^2.7.0"
	},
	"devDependencies": {
		"@docvia/source": "workspace:*",
		"@types/node": "catalog:",
		"next": "^16.3.8",
		"typescript": "catalog:",
		"webpack": "^5.111.1"
	},
	"peerDependencies": {
		"@docvia/source": "workspace:*",
		"next": ">=14"
	},
	"description": "Next.js integration for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/plugin-next"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	],
	"sideEffects": false
}
