{
	"name": "@docvia/plugins",
	"version": "0.3.1",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"jiti": "^2.7.0"
	},
	"devDependencies": {
		"@docvia/plugin-shiki": "workspace:*",
		"@docvia/renderer-react": "workspace:*",
		"@types/node": "catalog:",
		"svelte": "catalog:",
		"typescript": "catalog:"
	},
	"description": "Plugin runner, defineConfig, and config loader for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/plugins"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	],
	"sideEffects": false
}
