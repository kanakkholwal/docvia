{
	"name": "@docvia/plugin-openapi",
	"version": "0.2.2",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"js-yaml": "^5.4.2"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"description": "OpenAPI 3.x renderer for docvia. Transforms `openapi METHOD /path` fenced blocks into rich endpoint cards.",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/plugin-openapi"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia",
		"openapi",
		"swagger",
		"api"
	],
	"sideEffects": false
}
