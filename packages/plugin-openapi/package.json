{
	"name": "@docvia/plugin-openapi",
	"version": "0.2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"js-yaml": "^4.1.1"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.5.0",
		"typescript": "^5.9.3"
	},
	"description": "OpenAPI 3.x renderer for docvia. Transforms `openapi METHOD /path` fenced blocks into rich endpoint cards.",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/plugin-openapi"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia",
		"openapi",
		"swagger",
		"api"
	]
}
