{
	"name": "@docvia/plugin-openapi",
	"version": "2.0.0",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./proxy": "./dist/proxy.js",
		"./source": "./dist/source.js",
		"./vite": "./dist/vite.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/core": "workspace:*",
		"@scalar/openapi-parser": "^0.29.11",
		"@scalar/snippetz": "^0.10.6",
		"micromark": "^4.0.3"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"description": "OpenAPI for docvia: generated API reference pages with code samples, and inline `openapi METHOD /path` blocks.",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/plugin-openapi"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia",
		"openapi",
		"swagger",
		"api"
	],
	"sideEffects": false
}
