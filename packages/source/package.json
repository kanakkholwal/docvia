{
	"name": "@docvia/source",
	"version": "0.4.0",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./internal": "./dist/internal.js",
		"./runtime": "./dist/runtime.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/renderer-core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"description": "Runtime collection model for consuming compiled docvia output",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/source"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	],
	"sideEffects": false
}
