{
	"name": "@docvia/source",
	"version": "0.1.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.mts",
			"import": "./dist/runtime.mjs",
			"default": "./dist/runtime.mjs"
		},
		"./internal": {
			"types": "./dist/internal.d.mts",
			"import": "./dist/internal.mjs",
			"default": "./dist/internal.mjs"
		},
		"./node": {
			"types": "./dist/node.d.mts",
			"import": "./dist/node.mjs",
			"default": "./dist/node.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "echo \"no tests yet\""
	},
	"dependencies": {
		"@docvia/core": "workspace:*",
		"@docvia/ir": "workspace:*",
		"@docvia/renderer-core": "workspace:*",
		"@docvia/schema": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"svelte": "^5.49.2",
		"typescript": "^5.9.3",
		"shiki": "^4.0.2"
	},
	"description": "Runtime collection helpers and Node markdown loader for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/source"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	]
}
