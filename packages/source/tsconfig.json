{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "baseUrl": ".",
        "paths": {
            "@dockit/core": [
                "../core/src/index.ts"
            ],
            "@dockit/ir": [
                "../ir/src/index.ts"
            ],
            "@dockit/renderer-core": [
                "../renderer-core/src/index.ts"
            ],
            "@dockit/schema": [
                "../schema/src/index.ts"
            ]
        },
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ],
    "references": [
        {
            "path": "../ir"
        },
        {
            "path": "../core"
        },
        {
            "path": "../schema"
        },
        {
            "path": "../renderer-core"
        }
    ]
}
