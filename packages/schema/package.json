{
	"name": "@docvia/schema",
	"version": "2.0.0",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"@standard-schema/spec": "^1.1.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"zod": "^4.3.6"
	},
	"description": "Standard Schema frontmatter validation, YAML parsing, and type codegen for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/schema"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	],
	"sideEffects": false
}
