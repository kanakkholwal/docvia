{
	"name": "@docvia/schema",
	"version": "0.2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"@standard-schema/spec": "^1.1.0",
		"yaml": "^2.8.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"svelte": "^5.49.2",
		"typescript": "^5.9.3"
	},
	"description": "Standard Schema frontmatter validation, YAML parsing, and TS codegen for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/schema"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	]
}
