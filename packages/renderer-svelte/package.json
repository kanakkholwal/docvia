{
	"name": "@docvia/renderer-svelte",
	"version": "0.2.4",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"default": "./dist/node.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "svelte-package --input src --output dist",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "echo \"no tests yet\""
	},
	"dependencies": {
		"@docvia/ir": "workspace:*",
		"@docvia/renderer-core": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:"
	},
	"description": "Svelte renderer adapter for docvia",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/renderer-svelte"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"docvia"
	],
	"sideEffects": false,
	"svelte": "./dist/index.js",
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
