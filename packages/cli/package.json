		"@docvia/renderer-svelte": "workspace:*",
		"@docvia/search": "workspace:*",
		"chokidar": "^5.0.0",
		"commander": "^14.0.3",
		"sirv": "^3.0.2"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"svelte": "^5.49.2",
		"typescript": "^5.9.3"
	}
