{
	"name": "@docvia/cli",
	"version": "0.2.1",
	"description": "Build-time documentation compiler — CLI entry point",
	"type": "module",
	"bin": {
		"docvia": "./bin.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"bin.mjs",
		"dist",
		"README.md"
	],
	"keywords": [
		"docs",
		"documentation",
		"compiler",
		"markdown",
		"static-site"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "echo \"no tests yet\""
	},
	"dependencies": {
		"@docvia/compiler": "workspace:*",
		"@docvia/ir": "workspace:*",
		"@docvia/plugins": "workspace:*",
		"@docvia/runtime": "workspace:*",
		"chokidar": "^5.0.0",
		"commander": "^14.0.3",
		"sirv": "^3.0.2"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"typescript": "^5.9.3"
	},
	"publishConfig": {
		"access": "public"
	}
}
