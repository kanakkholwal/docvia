{
	"name": "@docvia/cli",
	"version": "1.0.0",
	"description": "docvia CLI: add docs to a Next.js, SvelteKit or TanStack Start app",
	"type": "module",
	"bin": {
		"docvia": "./bin.mjs"
	},
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"bin.mjs",
		"dist",
		"templates",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"docs",
		"documentation",
		"compiler",
		"markdown",
		"static-site"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/kanakkholwal/docvia.git",
		"directory": "packages/cli"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch --no-clean",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@docvia/compiler": "workspace:*",
		"@docvia/ir": "workspace:*",
		"@docvia/plugins": "workspace:*",
		"@docvia/runtime": "workspace:*",
		"chokidar": "^5.0.0",
		"commander": "^15.0.0",
		"sirv": "^3.0.2",
		"magic-string": "^1.4.3",
		"oxc-parser": "^0.152.0"
	},
	"peerDependencies": {
		"@docvia/source": "workspace:*"
	},
	"devDependencies": {
		"@docvia/source": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	}
}
