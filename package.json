{
    "name": "docvia-mvp",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "lint": "biome check .",
        "lint:fix": "biome check --fix .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "test": "turbo run test",
        "dev": "turbo run dev",
        "prepare": "husky",
        "setup": "pnpm install && pnpm build && pnpm test",
        "reset": "node ./scripts/clean-builds.js",
        "cleanup": "node ./scripts/clean-src-dts.js"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.9",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "tsup": "^8.5.1",
        "turbo": "^2.8.21",
        "typescript": "^5.9.3"
    },
    "lint-staged": {
        "*.{ts,js,json}": [
            "biome check --fix --no-errors-on-unmatched"
        ]
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=20.0.0"
    }
}