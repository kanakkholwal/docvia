{
	"name": "docvia-mvp",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo run build && pnpm run cleanup:dts",
		"typecheck": "turbo run typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"test": "turbo run test",
		"dev": "turbo run dev --concurrency=15",
		"prepare": "husky",
		"setup": "pnpm install && pnpm build && pnpm test",
		"clean": "node ./scripts/clean-builds.js && pnpm run cleanup:dts",
		"cleanup:dts": "node ./scripts/clean-src-dts.js",
		"changeset": "changeset",
		"changeset:status": "changeset status --since=origin/main",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish",
		"ci": "pnpm lint && pnpm build && pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"tsdown": "^0.21.7",
		"turbo": "^2.8.21",
		"typescript": "^5.9.3",
		"vitest": "^2.0.0"
	},
	"lint-staged": {
		"*.{ts,js,json}": [
			"biome check --fix --no-errors-on-unmatched"
		]
	},
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=20.0.0"
	}
}
